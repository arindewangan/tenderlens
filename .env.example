# Copy to .env and fill in.  Never commit real keys.
# Free SerpApi key (250 searches/month): https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# Optional: OpenAI-compatible LLM for AI-written tender briefs.
# Without these, TenderLens uses built-in template briefs (labelled as such).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: Flask session secret for production
FLASK_SECRET_KEY=change-me
